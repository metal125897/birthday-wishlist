rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@birthday-wishlist.local';
    }

    function hasGiftShape(data) {
      return data.keys().hasAll([
          'title', 'description', 'desireLevel', 'price', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'desireLevel', 'price', 'category', 'status', 'createdAt'
        ]);
    }

    function isValidGift(data) {
      return hasGiftShape(data)
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 4000
        && data.desireLevel is int
        && data.desireLevel >= 1
        && data.desireLevel <= 5
        && (data.price == null || (
          data.price is int
          && data.price >= 1
          && data.price <= 99999999
        ))
        && (!('category' in data) || data.category == null || (
          data.category is string
          && data.category in [
            'Self Care & Cosmetics', 'Sport', 'Just Pleasure', 'Food', 'Needs'
          ]
        ))
        && data.status in ['available', 'reserved']
        && data.createdAt is timestamp;
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow create: if isAdmin() && isValidGift(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (
          isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
        && isValidGift(request.resource.data);
    }

    function isValidGiftGuidance(data) {
      return data.keys().hasAll(['things', 'brands', 'updatedAt'])
        && data.keys().hasOnly(['things', 'brands', 'updatedAt'])
        && data.things is string
        && data.things.size() > 0
        && data.things.size() <= 4000
        && data.brands is string
        && data.brands.size() > 0
        && data.brands.size() <= 4000
        && data.updatedAt is timestamp;
    }

    match /siteContent/giftGuidance {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGiftGuidance(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
